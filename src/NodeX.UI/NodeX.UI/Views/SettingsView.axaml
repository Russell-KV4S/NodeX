<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NodeX.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="900"
             x:Class="NodeX.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{StaticResource ConsoleBackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="560" Margin="16" Spacing="16" HorizontalAlignment="Stretch">

            <StackPanel Spacing="2">
                <TextBlock Text="Station settings" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Classes="hint" Margin="0"
                           Text="Enter the details of the node you registered on the AllStarLink portal (allstarlink.org)." />
                <TextBlock Classes="hint" Margin="0" Text="{Binding VersionText}" />
            </StackPanel>

            <!-- STATION -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sectionTitle" Text="Your node" />

                    <StackPanel>
                        <TextBlock Classes="label" Text="Node number" />
                        <TextBox AutomationProperties.Name="Node number" Text="{Binding NodeNumber}" PlaceholderText="e.g. 55553" MaxLength="7" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="Node password" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" AutomationProperties.Name="Node password" Text="{Binding Password}" PasswordChar="●"
                                     RevealPassword="{Binding ShowPassword}" PlaceholderText="Password set on the portal" />
                            <CheckBox Grid.Column="1" Content="Show" IsChecked="{Binding ShowPassword}" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Classes="hint"
                                   Text="This is the password you set for your node on the AllStarLink portal. It is stored encrypted by your operating system and is only ever sent to AllStarLink's registration server, never to other nodes." />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding CallsignLabel}" />
                        <TextBox AutomationProperties.Name="Callsign" Text="{Binding Callsign}" PlaceholderText="e.g. W1AW" MaxLength="14" />
                        <CheckBox Content="I don't have a callsign: listen only" IsChecked="{Binding ListenOnly}" Margin="0,8,0,0" />
                        <TextBlock Classes="hint"
                                   Text="Transmitting needs an amateur radio licence. NodeX does not check your callsign, so you are responsible for using it correctly. In listen-only mode you can still connect to any node and hear it, but the push-to-talk button is turned off." />
                    </StackPanel>

                    <CheckBox Content="Register with AllStarLink when the app starts" IsChecked="{Binding RegisterOnStartup}" />
                </StackPanel>
            </Border>

            <!-- CONNECTING -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sectionTitle" Text="Connecting" />

                    <StackPanel>
                        <TextBlock Classes="label" Text="Default node to connect to (optional)" />
                        <TextBox AutomationProperties.Name="Default node to connect to" Text="{Binding DefaultTargetNode}" PlaceholderText="e.g. 27339" MaxLength="7" />
                    </StackPanel>

                    <StackPanel>
                        <CheckBox Content="Reconnect automatically if the link drops or the network changes"
                                  IsChecked="{Binding AutoReconnect}" />
                        <TextBlock Classes="hint"
                                   Text="Useful on a phone moving between Wi-Fi and mobile data. A connection that was never answered, or that the other node ends on purpose, is not retried." />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="Favorite nodes (optional)" />
                        <TextBox AutomationProperties.Name="Favorite nodes" Text="{Binding FavoritesText}" PlaceholderText="e.g. 27339, 2000, 41200" AcceptsReturn="False" />
                        <TextBlock Classes="hint" Text="Separate node numbers with commas or spaces." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- PTT & AUDIO -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sectionTitle" Text="Push-to-talk and audio" />

                    <CheckBox Content="Toggle PTT (tap to talk, tap again to stop)" IsChecked="{Binding TogglePtt}" />

                    <!-- Always listed so it can be found; only an Android phone has an earpiece to switch from. -->
                    <CheckBox Content="Use the loudspeaker by default (instead of the phone earpiece)"
                              IsChecked="{Binding DefaultToSpeaker}" IsEnabled="{Binding AudioRouteSupported}" />
                    <TextBlock Classes="hint" Margin="0,-8,0,0" IsVisible="{Binding !AudioRouteSupported}"
                               Text="Phone only: this computer has a single audio output, so there is nothing to switch." />

                    <!-- Android Auto talk (Android only; off by default) -->
                    <StackPanel Spacing="6" IsVisible="{Binding CarTalkSupported}">
                        <CheckBox Content="Android Auto: show a Talk button on the car screen"
                                  IsChecked="{Binding CarPtt}" />
                        <TextBlock Classes="hint" Margin="28,-4,0,0" TextWrapping="Wrap"
                                   Text="Tap Talk to go on air, tap again to stop. It only keys the node you chose as the transmit node, and it stops by itself at the time-out timer, on a call or navigation prompt, or when the car disconnects. Uses the phone's microphone. Check the node's links first: this can reach your RF station." />
                        <StackPanel Margin="28,0,0,0" Spacing="4" IsEnabled="{Binding CarPtt}">
                            <TextBlock Classes="label" Text="Steering-wheel button that talks" />
                            <ComboBox SelectedIndex="{Binding CarWheelIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="None (use the on-screen Talk button)" />
                                <ComboBoxItem Content="Next button talks (Back still skips favourites)" />
                                <ComboBoxItem Content="Back button talks (Next still skips favourites)" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- A phone button as PTT (Android) -->
                    <StackPanel IsVisible="{Binding HardwareKeysSupported}">
                        <TextBlock Classes="label" Text="Phone button for push-to-talk" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding HardwareKeyText}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button Grid.Column="1" Content="Choose button" Command="{Binding LearnHardwareKeyCommand}"
                                    MinHeight="44" Padding="12,0" CornerRadius="6" />
                            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearHardwareKeyCommand}"
                                    IsEnabled="{Binding HasHardwareKey}" MinHeight="44" Padding="12,0" CornerRadius="6" />
                        </Grid>
                        <TextBlock Classes="hint"
                                   Text="Press “Choose button”, then press a volume key or a headset button. It then works like the on-screen PTT: hold to talk, or tap to start and tap again to stop if Toggle PTT is on. It works while NodeX is on screen; a volume key used this way no longer changes the volume. Save to keep it." />
                    </StackPanel>

                    <!-- A Bluetooth headset's Play/Pause button as PTT (Android; off by default) -->
                    <StackPanel Spacing="6" IsVisible="{Binding HardwareKeysSupported}">
                        <CheckBox Content="Headset Play/Pause button is push-to-talk"
                                  IsChecked="{Binding MediaKeyPtt}" />
                        <TextBlock Classes="hint" Margin="28,-4,0,0" TextWrapping="Wrap"
                                   Text="While linked, press the button on your Bluetooth headset or earbuds to go on air, and press again to stop (a headset button can't be held, so this is always tap to talk). You hear a beep when you start, a lower one when you stop, and a buzz if it was refused. It works with the screen off, keys only the transmit node, stops if the headset disconnects, and takes over that button from your music apps while linked. Check the node's links first: this can reach your RF station." />
                    </StackPanel>

                    <!-- Bluetooth (BLE) push-to-talk button (Android) -->
                    <StackPanel Spacing="6" IsVisible="{Binding BleSupported}">
                        <TextBlock Classes="label" Text="Bluetooth push-to-talk button" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding BleSummaryText}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Forget" Command="{Binding ForgetBleCommand}"
                                    IsEnabled="{Binding HasBleButton}" MinHeight="44" Padding="12,0" CornerRadius="6" />
                        </Grid>
                        <Button Content="Scan for buttons" Command="{Binding ScanBleCommand}"
                                IsEnabled="{Binding !IsBleScanning}" MinHeight="44" Padding="12,0" CornerRadius="6" />
                        <ListBox ItemsSource="{Binding BleDevices}" SelectedItem="{Binding SelectedBleDevice}"
                                 MaxHeight="160" IsVisible="{Binding HasBleDevices}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Margin="4,8" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Set up button" Command="{Binding LearnBleCommand}"
                                IsEnabled="{Binding CanLearnBle}" MinHeight="44" Padding="12,0" CornerRadius="6" />
                        <TextBlock Text="{Binding BleLearnText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Classes="hint"
                                   Text="Turn the button on, press “Scan for buttons”, pick it, then “Set up button”: NodeX asks you to press and hold, then release, and remembers exactly what your button sends. Only that signal keys the transmitter. It works like the on-screen PTT (hold to talk, or tap to start and tap again to stop if Toggle PTT is on) and keys only the transmit node. If the button disconnects while you are talking, NodeX stops transmitting. Save to keep it." />
                    </StackPanel>

                    <!-- Microphone and speaker choice (desktop) -->
                    <StackPanel Spacing="4" IsVisible="{Binding AudioDevicesSupported}">
                        <TextBlock Classes="label" Text="Microphone" />
                        <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Microphone" />
                        <TextBlock Classes="label" Text="Speaker" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Speaker" />
                        <TextBlock Classes="hint" Text="Applies the next time you connect. If a chosen device is unplugged, NodeX uses the system default." />
                    </StackPanel>

                    <CheckBox Content="Clean up my voice (rumble filter, automatic level, limiter)" IsChecked="{Binding MicProcessing}" />

                    <StackPanel>
                        <TextBlock Classes="label" Text="Transmit time-out (seconds)" />
                        <TextBox AutomationProperties.Name="Transmit time-out in seconds" Text="{Binding TimeOutSecondsText}" MaxLength="3" />
                        <TextBlock Classes="hint" Text="Transmit is cut automatically after this long, to protect against a stuck PTT." />
                    </StackPanel>

                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="label" Text="Microphone gain" />
                            <TextBlock Grid.Column="1" Classes="label" Text="{Binding MicGain, StringFormat='{}{0:0.0}×'}" />
                        </Grid>
                        <Slider AutomationProperties.Name="Microphone gain" Minimum="0.5" Maximum="4" Value="{Binding MicGain}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- STATION ID REMINDER -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sectionTitle" Text="Station ID reminder" />

                    <CheckBox Content="Remind me to identify while I'm transmitting" IsChecked="{Binding IdReminderEnabled}" />

                    <StackPanel>
                        <TextBlock Classes="label" Text="Remind me after (minutes)" />
                        <TextBox AutomationProperties.Name="Station ID reminder minutes" Text="{Binding IdReminderMinutesText}" MaxLength="2" />
                        <TextBlock Classes="hint" Text="Counted from when you start transmitting. NodeX only shows a reminder; it never sends an ID or any audio except your voice. You are responsible for following the identification rules that apply to you." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- MOVE SETTINGS TO ANOTHER DEVICE -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sectionTitle" Text="Move settings to another device" />
                    <TextBlock Classes="hint" Margin="0"
                               Text="Export what is on this screen, then import it on your other phone or computer (send the file or text to yourself by e-mail, chat or cloud storage). Importing only fills in the form: nothing changes until you press Save." />

                    <StackPanel>
                        <TextBlock Classes="label" Text="Passphrase (optional)" />
                        <TextBox AutomationProperties.Name="Passphrase for the exported node password" Text="{Binding TransferPassphrase}"
                                 PasswordChar="●" PlaceholderText="Needed to carry the node password" />
                        <TextBlock Classes="hint"
                                   Text="With a passphrase the node password is included, encrypted, and you need the same passphrase to import it. Without one, the password is left out and you enter it again on the other device." />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" IsEnabled="{Binding IsIdle}">
                        <Button Grid.Row="0" Grid.Column="0" Content="Export to file…" Click="OnExportFileClick"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" CornerRadius="6" />
                        <Button Grid.Row="0" Grid.Column="1" Content="Import from file…" Click="OnImportFileClick"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" CornerRadius="6" />
                        <Button Grid.Row="1" Grid.Column="0" Content="Copy to clipboard" Click="OnCopyExportClick"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" CornerRadius="6" />
                        <Button Grid.Row="1" Grid.Column="1" Content="Paste from clipboard" Click="OnPasteImportClick"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" CornerRadius="6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- TROUBLESHOOTING -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sectionTitle" Text="Troubleshooting" />
                    <TextBlock Classes="hint" Margin="0"
                               Text="NodeX keeps a log file on this device (the last few hundred KB). Turn on detailed logging, reproduce the problem (for example, switch from Wi-Fi to cellular while linked), then send the log." />

                    <CheckBox Content="Detailed logging (step timings and protocol state; turn off afterwards)"
                              IsChecked="{Binding DetailedLogging}" />

                    <Button Content="Send logs…" Command="{Binding SendLogsCommand}" IsVisible="{Binding LogSharingSupported}"
                            IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            MinHeight="44" CornerRadius="6" />
                    <TextBlock Classes="hint" IsVisible="{Binding LogSharingSupported}"
                               Text="Opens your share sheet (e-mail, Drive, chat...). The log has your node number, callsign and IP addresses, never your password. Detailed logging takes effect when you press Save." />
                </StackPanel>
            </Border>

            <!-- ADVANCED -->
            <Expander Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Registration server" />
                        <TextBox AutomationProperties.Name="Registration server" Text="{Binding RegistrationUrl}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="label" Text="IAX2 port reported to AllStarLink" />
                        <TextBox AutomationProperties.Name="IAX2 port" Text="{Binding IaxPortText}" MaxLength="5" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <TextBlock Classes="hint" HorizontalAlignment="Center" Margin="0,0,0,8"
                       Text="“Test registration” registers your node with AllStarLink right now using the values above; nothing is saved until you press Save." />
        </StackPanel>
    </ScrollViewer>

    <!-- PINNED ACTION BAR: feedback and Save/Cancel stay on screen however far the form is scrolled -->
    <Border Grid.Row="1" Background="{StaticResource HeaderBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
        <StackPanel MaxWidth="560" Spacing="10">
            <!-- FEEDBACK -->
    <Border IsVisible="{Binding HasError}" Background="#2A1215" BorderBrush="{StaticResource TxRedBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12">
        <TextBlock Text="{Binding ErrorText}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <Border IsVisible="{Binding HasStatus}" Background="#0F2A22" BorderBrush="{StaticResource RxGreenBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12">
        <TextBlock Text="{Binding StatusText}" Foreground="#6EE7B7" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <!-- ACTIONS -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" IsEnabled="{Binding IsIdle}">
        <Button Grid.Column="0" Content="Test registration" Command="{Binding TestRegistrationCommand}"
                CornerRadius="6" Padding="14,10" />
        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}"
                Background="Transparent" CornerRadius="6" Padding="14,10" Margin="0,0,8,0" />
        <Button Grid.Column="3" Content="Save" Command="{Binding SaveCommand}"
                Background="{StaticResource RxGreenBrush}" Foreground="#000000" FontWeight="Bold"
                CornerRadius="6" Padding="22,10" />
    </Grid>
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
