<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NodeX.UI.ViewModels"
             xmlns:views="using:NodeX.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="750"
             x:Class="NodeX.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource ConsoleBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- RX / TX activity cards and their dots -->
        <Style Selector="Border#RxCard">
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        </Style>
        <Style Selector="Border#RxCard.active">
            <Setter Property="BorderBrush" Value="{StaticResource RxGreenBrush}" />
            <Setter Property="Background" Value="#1A10B981" />
        </Style>
        <Style Selector="Border#TxCard">
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        </Style>
        <Style Selector="Border#TxCard.active">
            <Setter Property="BorderBrush" Value="{StaticResource TxRedBrush}" />
            <Setter Property="Background" Value="#26EF4444" />
        </Style>
        <Style Selector="Border#RxDot">
            <Setter Property="Background" Value="#374151" />
        </Style>
        <Style Selector="Border#RxDot.on">
            <Setter Property="Background" Value="{StaticResource RxGreenBrush}" />
        </Style>
        <Style Selector="Border#TxDot">
            <Setter Property="Background" Value="#374151" />
        </Style>
        <Style Selector="Border#TxDot.on">
            <Setter Property="Background" Value="{StaticResource TxRedBrush}" />
        </Style>

        <!-- Registration dot: amber until registered, then green -->
        <Style Selector="Ellipse#AslDot">
            <Setter Property="Fill" Value="{StaticResource AmberAccentBrush}" />
        </Style>
        <Style Selector="Ellipse#AslDot.registered">
            <Setter Property="Fill" Value="{StaticResource RxGreenBrush}" />
        </Style>

        <!-- Bluetooth dot: grey until a headset/speaker-mic is connected, then cyan -->
        <Style Selector="Ellipse#BleDot">
            <Setter Property="Fill" Value="#6B7280" />
        </Style>
        <Style Selector="Ellipse#BleDot.connected">
            <Setter Property="Fill" Value="{StaticResource CyanAccentBrush}" />
        </Style>

        <!-- PTT button: the button itself is transparent and the visible face is a Border inside it, so the
             theme's hover/press styling can never override the keyed (red) state. Order matters below:
             later rules of equal specificity win, so the keyed rules come last. -->
        <Style Selector="Border#PttFace">
            <Setter Property="Background" Value="#222834" />
            <Setter Property="BorderBrush" Value="#374151" />
        </Style>
        <Style Selector="Button#PttButton:pointerover Border#PttFace">
            <Setter Property="Background" Value="#2D3748" />
            <Setter Property="BorderBrush" Value="#4B5563" />
        </Style>
        <Style Selector="Button#PttButton Border#PttFace.keyed">
            <Setter Property="Background" Value="{StaticResource TxRedBrush}" />
            <Setter Property="BorderBrush" Value="#FF8080" />
        </Style>
        <!-- Transmit off: clearly inert, never red -->
        <Style Selector="Button#PttButton:disabled Border#PttFace">
            <Setter Property="Background" Value="#161A22" />
            <Setter Property="BorderBrush" Value="#2B3340" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button#PttButton:pointerover Border#PttFace.keyed">
            <Setter Property="Background" Value="{StaticResource TxRedBrush}" />
            <Setter Property="BorderBrush" Value="#FF8080" />
        </Style>

        <!-- Keypad -->
        <Style Selector="Button.key">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Linked-node rows: the transmit node gets a red left edge and a text tag (never colour alone) -->
        <Style Selector="Border.linkRow">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <!-- Top-bar link chips: amber while connecting/reconnecting, green once up (text states it too) -->
        <Style Selector="Border.linkChip">
            <Setter Property="Background" Value="#2A2410" />
            <Setter Property="BorderBrush" Value="{StaticResource AmberAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.linkChip.up">
            <Setter Property="Background" Value="#0F2A22" />
            <Setter Property="BorderBrush" Value="{StaticResource RxGreenBrush}" />
        </Style>
        <Style Selector="Ellipse.chipDot">
            <Setter Property="Fill" Value="{StaticResource AmberAccentBrush}" />
        </Style>
        <Style Selector="Ellipse.chipDot.up">
            <Setter Property="Fill" Value="{StaticResource RxGreenBrush}" />
        </Style>
        <Style Selector="Border.linkRow.tx">
            <Setter Property="BorderBrush" Value="{StaticResource TxRedBrush}" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Phone / narrow mode (the 'narrow' class is toggled by MainView.axaml.cs): finger-sized targets -->
        <Style Selector="UserControl.narrow Button">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="UserControl.narrow TextBox">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="UserControl.narrow Button.key">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="UserControl.narrow Button#PttButton">
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOP APP / CONSOLE HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
          <StackPanel Spacing="8">
            <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto">

                <!-- Branding -->
                <StackPanel x:Name="BrandPanel" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="avares://NodeX.UI/Assets/nodex-mark.png" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NodeX" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="BrandTagline" Text="AllStarLink Radioless Node" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Station callout -->
                <Border x:Name="StationBadge" Grid.Column="1" HorizontalAlignment="Center"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="20" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="STATION:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocalCallsign}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocalNodeNumber, StringFormat='Node {0}'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Registration + Bluetooth badges (wrap onto a second line when space is tight) -->
                <WrapPanel x:Name="BadgesPanel" Grid.Column="2" Orientation="Horizontal"
                           ItemSpacing="10" LineSpacing="6" VerticalAlignment="Center">
                    <Border Classes="card" CornerRadius="12" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="AslDot" Width="8" Height="8" Classes.registered="{Binding IsAslRegistered}" />
                            <TextBlock Text="{Binding AslStatusText}" FontSize="11" MaxWidth="240"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" CornerRadius="12" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="BleDot" Width="8" Height="8" Classes.connected="{Binding IsBleConnected}" />
                            <TextBlock Text="{Binding BleStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Button x:Name="SettingsButton" AutomationProperties.Name="Open menu" Grid.Column="3" Content="Menu ▾"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        CornerRadius="12" Padding="12,5" FontSize="11" FontWeight="SemiBold">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}" />
                            <MenuItem Header="Find a node…" Command="{Binding OpenSearchCommand}" />
                            <Separator IsVisible="{Binding CanExit}" />
                            <MenuItem Header="Exit NodeX" Command="{Binding ExitCommand}" IsVisible="{Binding CanExit}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Links strip: always visible, so scrolling to the log never hides what you are connected to -->
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <TextBlock Text="{Binding LinkCountText, StringFormat='LINKED {0}'}" IsVisible="{Binding HasLinks}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Not linked to any node" IsVisible="{Binding !HasLinks}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <ItemsControl ItemsSource="{Binding LinkItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkItemViewModel">
                            <Border Classes="linkChip" Classes.up="{Binding IsConnected}"
                                    Margin="0,0,6,4" CornerRadius="12" Padding="9,3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Classes="chipDot" Classes.up="{Binding IsConnected}" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChipTitle}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ChipStatus}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- MAIN BODY CONTENT -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Padding="16" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="BodyGrid" ColumnDefinitions="*,360" HorizontalAlignment="Stretch">

                <!-- LEFT COLUMN (wide layout): transceiver hero, RX/TX, meters, PTT -->
                <StackPanel x:Name="LeftColumn" Grid.Column="0" Spacing="16" Margin="0,0,16,0">

                    <!-- HERO NODE DISPLAY CARD -->
                    <Border x:Name="HeroCard" Classes="card" Padding="20">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" CornerRadius="6" Padding="8,4" Background="#1F2937">
                                    <TextBlock Text="{Binding ConnectionStateBadgeText}"
                                               FontWeight="Bold" FontSize="11"
                                               Foreground="{StaticResource CyanAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="RTT:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding LatencyText}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,16,0,8">
                                <TextBlock Text="{Binding ConnectedNodeDisplay}"
                                           FontSize="32" FontWeight="Black"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ConnectedNodeDetails}"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <!-- Optional station-ID reminder (text only; nothing is transmitted) -->
                                <Border IsVisible="{Binding IsIdReminderDue}" Margin="0,12,0,0" Padding="12,8"
                                        CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{StaticResource AmberAccentBrush}" Background="#2A1F0A">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Time to identify (say your callsign)." FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AmberAccentBrush}" />
                                        <Button Grid.Column="1" Content="I've identified" Command="{Binding AcknowledgeIdCommand}"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource AmberAccentBrush}" BorderThickness="1"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                CornerRadius="8" Padding="10,5" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RX / TX LIVE ACTIVITY CARDS -->
                    <Grid x:Name="RxTxRow" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border x:Name="RxCard" AutomationProperties.Name="Receive indicator" Grid.Column="0" Classes="card" Classes.active="{Binding IsRemoteKeyed}"
                                BorderThickness="2" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border x:Name="RxDot" Width="16" Height="16" CornerRadius="8" Classes.on="{Binding IsRemoteKeyed}" />
                                <StackPanel>
                                    <TextBlock Text="RECEIVE (RX)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <!-- Text state, so on-air status never depends on colour alone (and shows on phones too) -->
                                    <StackPanel x:Name="RxSubtitle">
                                        <TextBlock Text="Idle" FontSize="11" IsVisible="{Binding !IsRemoteKeyed}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Receiving" FontSize="11" FontWeight="Bold" IsVisible="{Binding IsRemoteKeyed}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Foreground="{StaticResource RxGreenBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="TxCard" AutomationProperties.Name="Transmit indicator" Grid.Column="1" Classes="card" Classes.active="{Binding IsTransmitting}"
                                BorderThickness="2" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border x:Name="TxDot" Width="16" Height="16" CornerRadius="8" Classes.on="{Binding IsTransmitting}" />
                                <StackPanel>
                                    <TextBlock Text="TRANSMIT (TX)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <StackPanel x:Name="TxSubtitle">
                                        <TextBlock Text="Idle" FontSize="11" IsVisible="{Binding !IsTransmitting}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="ON AIR" FontSize="11" FontWeight="Bold" IsVisible="{Binding IsTransmitting}"
                                                   AutomationProperties.LiveSetting="Assertive"
                                                   Foreground="#FCA5A5" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- AUDIO VU METERS -->
                    <Border x:Name="MetersCard" Classes="card" CornerRadius="10">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="50,*,40">
                                <TextBlock Grid.Column="0" Text="MIC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" AutomationProperties.Name="Microphone level" Minimum="0" Maximum="1" Value="{Binding MicAudioLevel}"
                                             Height="8" CornerRadius="4" Margin="8,0"
                                             Foreground="{StaticResource TxRedBrush}" Background="#1F2937" />
                                <TextBlock Grid.Column="2" Text="{Binding MicAudioLevel, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="50,*,40">
                                <TextBlock Grid.Column="0" Text="SPK" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" AutomationProperties.Name="Speaker level" Minimum="0" Maximum="1" Value="{Binding RxAudioLevel}"
                                             Height="8" CornerRadius="4" Margin="8,0"
                                             Foreground="{StaticResource RxGreenBrush}" Background="#1F2937" />
                                <TextBlock Grid.Column="2" Text="{Binding RxAudioLevel, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PUSH-TO-TALK: sits in the left column on wide screens, docks to the bottom on phones -->
                    <Border x:Name="PttCard" Classes="card" CornerRadius="16" Padding="24">
                        <StackPanel x:Name="PttInner" Spacing="18" HorizontalAlignment="Center">

                            <!-- Phone earpiece / loudspeaker (Android only). Lives with the PTT key so it is in
                                 thumb reach on the docked bar instead of down in the scrolling page. -->
                            <Button x:Name="SpeakerButton" IsVisible="{Binding CanSwitchSpeaker}" Command="{Binding ToggleSpeakerCommand}"
                                    AutomationProperties.Name="Switch between phone and speaker audio"
                                    Content="{Binding SpeakerButtonText}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="#1F2937" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" FontSize="13" FontWeight="SemiBold" />

                            <Button x:Name="PttButton" AutomationProperties.Name="Push to talk"
                                    Width="260" Height="140" Padding="0"
                                    CornerRadius="20" BorderThickness="0" Background="Transparent"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    IsEnabled="{Binding CanKey}"
                                    Command="{Binding TogglePttClickCommand}">
                                <Button.Resources>
                                    <!-- Neutralise the theme's own hover/press fills; the visible face is PttFace -->
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                </Button.Resources>
                                <Border x:Name="PttFace" CornerRadius="20" BorderThickness="3"
                                        Classes.keyed="{Binding IsTransmitting}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="PttCaption" Text="{Binding PttCaption}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#9CA3AF" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding PttHeadline}" FontSize="20" FontWeight="Black"
                                                   Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding TxDurationDisplay}" FontSize="16" FontWeight="Bold"
                                                   Foreground="#FFE4E6" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- Shown when transmitting is off (listen only, or microphone access denied). Listening still works. -->
                            <Border x:Name="TxBlockedBanner" IsVisible="{Binding IsTransmitBlocked}"
                                    Background="#2B2110" BorderBrush="{StaticResource AmberAccentBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding TransmitBlockedText}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="#FCD34D" AutomationProperties.LiveSetting="Polite" />
                                    <Button Content="Allow microphone" Command="{Binding FixMicrophoneCommand}"
                                            IsVisible="{Binding CanFixMicrophone}" HorizontalAlignment="Left"
                                            Padding="12,6" CornerRadius="6" FontSize="12" />
                                    <Button Content="Add callsign" Command="{Binding AddCallsignCommand}"
                                            IsVisible="{Binding CanAddCallsign}" HorizontalAlignment="Left"
                                            Padding="12,6" CornerRadius="6" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Nodes are linked but none is chosen for transmit: say so (the key stays inert) -->
                            <Border x:Name="ChooseTxBanner" IsVisible="{Binding NeedsTransmitNode}"
                                    Background="#2B2110" BorderBrush="{StaticResource AmberAccentBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <TextBlock Text="Pick which linked node to transmit to." TextWrapping="Wrap" FontSize="12"
                                           Foreground="#FCD34D" AutomationProperties.LiveSetting="Polite" />
                            </Border>

                            <StackPanel x:Name="PttInfo" Spacing="8" Width="300">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Time-Out Timer (TOT)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotCounterText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                                <ProgressBar AutomationProperties.Name="Transmit time-out used" Minimum="0" Maximum="1" Value="{Binding TotProgressPercent}"
                                             Height="6" CornerRadius="3"
                                             Foreground="{StaticResource AmberAccentBrush}" Background="#1F2937" />

                                <Button Command="{Binding TogglePttModeCommand}"
                                        AutomationProperties.Name="Switch push-to-talk mode"
                                        HorizontalAlignment="Center" Margin="0,4,0,0"
                                        Background="#1F2937" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="14" Padding="12,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Mode:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PttModeLabel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PttModeHint" Text="⇄ tap to switch" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN (wide layout): connect, DTMF, log -->
                <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="16">

                    <!-- LINKED NODES: up to 4 at once; only one is the transmit node, the rest are listen-only -->
                    <Border x:Name="LinksCard" Classes="card" IsVisible="{Binding HasLinks}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Linked nodes" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,3" Background="#1F2937">
                                    <TextBlock Text="{Binding LinkCountText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource CyanAccentBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="Choose one node to transmit to. All other links are listen-only."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

                            <ItemsControl ItemsSource="{Binding LinkItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LinkItemViewModel">
                                        <Border Classes="linkRow" Classes.tx="{Binding IsTransmitTarget}">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding HasDetails}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding RttText}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!-- Text pill, so "audio is arriving from this node" is not colour-only -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                                        <Border IsVisible="{Binding IsReceiving}" VerticalAlignment="Center"
                                                                CornerRadius="12" Padding="8,4" Background="#1A10B981"
                                                                BorderBrush="{StaticResource RxGreenBrush}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Ellipse Width="8" Height="8" Fill="{StaticResource RxGreenBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="Receiving" FontSize="11" FontWeight="Bold"
                                                                           AutomationProperties.LiveSetting="Polite"
                                                                           Foreground="{StaticResource RxGreenBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Favourite this node: star toggles, pencil (favourites only) renames -->
                                                        <Button Content="✎" FontSize="14" IsVisible="{Binding IsFavorite}"
                                                                AutomationProperties.Name="{Binding RenameAutomationName}"
                                                                MinWidth="36" MinHeight="36" Padding="0" CornerRadius="6"
                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                                    <StackPanel Spacing="8" Width="240">
                                                                        <TextBlock Text="Favorite name" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                        <TextBox AutomationProperties.Name="Favorite name"
                                                                                 Text="{Binding LabelInput}" MaxLength="40"
                                                                                 PlaceholderText="e.g. East Coast Reflector">
                                                                            <TextBox.KeyBindings>
                                                                                <KeyBinding Gesture="Enter" Command="{Binding SaveLabelCommand}" />
                                                                            </TextBox.KeyBindings>
                                                                        </TextBox>
                                                                        <Button Content="Save" Command="{Binding SaveLabelCommand}"
                                                                                HorizontalAlignment="Right" Padding="14,6" CornerRadius="6" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Button Content="{Binding FavoriteGlyph}" FontSize="20"
                                                                Command="{Binding ToggleFavoriteCommand}"
                                                                AutomationProperties.Name="{Binding FavoriteAutomationName}"
                                                                MinWidth="40" MinHeight="36" Padding="0" CornerRadius="6"
                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                Foreground="{StaticResource AmberAccentBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Border Grid.Column="0" IsVisible="{Binding IsTransmitTarget}" VerticalAlignment="Center"
                                                            CornerRadius="6" Padding="10,6" Background="{StaticResource TxRedBrush}">
                                                        <TextBlock Text="TRANSMIT HERE" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" />
                                                    </Border>
                                                    <Border Grid.Column="0" IsVisible="{Binding CanSelectTransmit}" VerticalAlignment="Center"
                                                            CornerRadius="6" Padding="10,6" Background="#1F2937">
                                                        <TextBlock Text="Listen only" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Transmit here" Command="{Binding SelectTransmitCommand}"
                                                            IsVisible="{Binding CanSelectTransmit}"
                                                            AutomationProperties.Name="{Binding SelectAutomationName}"
                                                            Background="#21262D" CornerRadius="6" Padding="12,6" FontSize="12" FontWeight="SemiBold" />
                                                </Grid>

                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Button Grid.Column="0" Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}"
                                                            AutomationProperties.Name="{Binding MuteAutomationName}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Background="#21262D" CornerRadius="6" Padding="10,6" FontSize="12" />
                                                    <Button Grid.Column="1" Content="Disconnect" Command="{Binding DisconnectCommand}"
                                                            AutomationProperties.Name="{Binding DisconnectAutomationName}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Background="{StaticResource DangerButtonBrush}" Foreground="#FFFFFF"
                                                            CornerRadius="6" Padding="10,6" FontSize="12" FontWeight="SemiBold" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Up to 4 nodes at once. Received audio from every node is mixed; your voice goes only to the transmit node."
                                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- CONNECT / DIAL CONTROL -->
                    <Border x:Name="ConnectCard" Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Connect to Node" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Connect adds another link; the nodes you are already linked to stay up."
                                       IsVisible="{Binding HasLinks}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />

                            <Grid x:Name="ConnectGrid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                                <!-- Star saves the number typed in the box; the pencil (favourites only) renames it -->
                                <StackPanel x:Name="TargetFavButtons" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                                    <Button Content="{Binding TargetFavoriteGlyph}" FontSize="20"
                                            AutomationProperties.Name="{Binding TargetFavoriteName}"
                                            Command="{Binding ToggleTargetFavoriteCommand}"
                                            MinWidth="44" MinHeight="40" Padding="0" CornerRadius="6"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Foreground="{StaticResource AmberAccentBrush}" />
                                    <Button Content="✎" FontSize="16" IsVisible="{Binding TargetIsFavorite}"
                                            AutomationProperties.Name="Rename this favorite"
                                            MinWidth="36" MinHeight="40" Padding="0" CornerRadius="6"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Spacing="8" Width="260">
                                                    <TextBlock Text="Favorite name" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBox AutomationProperties.Name="Favorite name"
                                                             Text="{Binding FavoriteLabelInput}" MaxLength="40"
                                                             PlaceholderText="e.g. East Coast Reflector">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter" Command="{Binding SaveFavoriteLabelCommand}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <Button Content="Save" Command="{Binding SaveFavoriteLabelCommand}"
                                                            HorizontalAlignment="Right" Padding="14,6" CornerRadius="6" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <TextBox x:Name="TargetBox" AutomationProperties.Name="Node number to connect to" Grid.Column="1" Text="{Binding TargetNodeInput}"
                                         PlaceholderText="e.g. 27339" Margin="0,0,8,0"
                                         FontSize="15" FontWeight="SemiBold"
                                         CornerRadius="6" VerticalContentAlignment="Center" />
                                <Grid x:Name="ConnectButtons" Grid.Column="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="0" Command="{Binding ConnectNodeCommand}"
                                            IsEnabled="{Binding CanConnect}"
                                            Background="{StaticResource RxGreenBrush}"
                                            Foreground="#000000" FontWeight="Bold"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            CornerRadius="6" Padding="14,8">
                                        Connect
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding DisconnectNodeCommand}"
                                            IsEnabled="{Binding CanDisconnect}"
                                            Background="{StaticResource DangerButtonBrush}"
                                            Foreground="#FFFFFF" FontWeight="Bold"
                                            Content="{Binding DisconnectAllText}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            CornerRadius="6" Padding="14,8" />
                                </Grid>
                            </Grid>

                            <Button Command="{Binding OpenSearchCommand}" AutomationProperties.Name="Find a node"
                                    HorizontalAlignment="Left" Padding="12,8" CornerRadius="6" FontSize="13">
                                🔍 Find a node…
                            </Button>

                            <StackPanel Spacing="6" IsVisible="{Binding HasFavorites}">
                                <TextBlock Text="Favorites (tap to connect, drag to reorder)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ItemsControl x:Name="FavoritesList" ItemsSource="{Binding FavoriteNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FavoriteItem">
                                            <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectFavoriteNodeCommand}"
                                                    CommandParameter="{Binding Node}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    Margin="0,0,6,6" Padding="10,6"
                                                    Background="#21262D" CornerRadius="6" BorderThickness="0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource CyanAccentBrush}" />
                                                    <TextBlock Text="{Binding Node}" FontSize="11" IsVisible="{Binding HasLabel}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DTMF KEYPAD -->
                    <Border x:Name="DtmfCard" Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="DTMF Radio Commands" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />

                            <ItemsControl ItemsSource="{Binding DtmfKeys}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="key" Content="{Binding}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SendDtmfDigitCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="AllStarLink Function Shortcuts" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
                                    <Button Grid.Column="0" Classes="chip" Content="*3 Link" Command="{Binding SendDtmfMacroCommand}" CommandParameter="link" />
                                    <Button Grid.Column="1" Classes="chip" Content="*1 Unlink" Command="{Binding SendDtmfMacroCommand}" CommandParameter="unlink" />
                                    <Button Grid.Column="2" Classes="chip" Content="*70 Status" Command="{Binding SendDtmfMacroCommand}" CommandParameter="status" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- LIVE ACTIVITY LOG -->
                    <Border x:Name="LogCard" Classes="card" Height="220">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0" Text="Event Log" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="CopyLogButton" Content="Copy" Click="OnCopyLogClick"
                                            AutomationProperties.Name="Copy event log to clipboard"
                                            Background="Transparent" BorderThickness="0" FontSize="11"
                                            Foreground="{StaticResource CyanAccentBrush}" Padding="8,0" />
                                    <Button Content="Clear" Command="{Binding ClearLogCommand}"
                                            Background="Transparent" BorderThickness="0" FontSize="11"
                                            Foreground="{StaticResource CyanAccentBrush}" Padding="8,0" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding ActivityLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- PTT DOCK: on phones the PTT card lives here, pinned to the bottom within thumb reach -->
        <Border x:Name="PttDock" Grid.Row="2" IsVisible="False"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,10" />

        <!-- FIND A NODE OVERLAY -->
        <Border Grid.RowSpan="3" IsVisible="{Binding IsSearchOpen}"
                Background="{StaticResource ConsoleBackgroundBrush}">
            <views:NodeSearchView DataContext="{Binding Search}" />
        </Border>

        <!-- SETTINGS OVERLAY (full screen so it works on phones as well as desktop) -->
        <Border Grid.RowSpan="3" IsVisible="{Binding IsSettingsOpen}"
                Background="{StaticResource ConsoleBackgroundBrush}">
            <views:SettingsView DataContext="{Binding Settings}" />
        </Border>
    </Grid>
</UserControl>
