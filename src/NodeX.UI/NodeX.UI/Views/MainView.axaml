<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NodeX.UI.ViewModels"
             xmlns:views="using:NodeX.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="750"
             x:Class="NodeX.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource ConsoleBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Registration dot: amber until registered, then green -->
        <Style Selector="Ellipse#AslDot">
            <Setter Property="Fill" Value="{DynamicResource AmberAccentBrush}" />
        </Style>
        <Style Selector="Ellipse#AslDot.registered">
            <Setter Property="Fill" Value="{DynamicResource RxGreenBrush}" />
        </Style>

        <!-- Bluetooth dot: grey until a headset/speaker-mic is connected, then cyan -->
        <Style Selector="Ellipse#BleDot">
            <Setter Property="Fill" Value="#6B7280" />
        </Style>
        <Style Selector="Ellipse#BleDot.connected">
            <Setter Property="Fill" Value="{DynamicResource CyanAccentBrush}" />
        </Style>

        <!-- PTT button: the button itself is transparent and the visible face is a Border inside it, so the
             theme's hover/press styling can never override the keyed (red) state. Order matters below:
             later rules of equal specificity win, so the keyed rules come last. -->
        <Style Selector="Border#PttFace">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        </Style>
        <Style Selector="Button#PttButton:pointerover Border#PttFace">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        </Style>
        <Style Selector="Button#PttButton Border#PttFace.keyed">
            <Setter Property="Background" Value="{DynamicResource TransmitFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TxRedBrush}" />
        </Style>
        <!-- Transmit off: clearly inert, never red -->
        <Style Selector="Button#PttButton:disabled Border#PttFace">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button#PttButton:pointerover Border#PttFace.keyed">
            <Setter Property="Background" Value="{DynamicResource TransmitFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TxRedBrush}" />
        </Style>

        <Style Selector="Border#PttFace TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Border#PttFace.keyed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnRedBrush}" />
        </Style>

        <!-- Keypad -->
        <Style Selector="Button.key">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Linked-node rows: the transmit node gets a red left edge and a text tag (never colour alone) -->
        <Style Selector="Border.linkRow">
            <Setter Property="Background" Value="{DynamicResource ConsoleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <!-- Top-bar link chips: amber while connecting/reconnecting, green once up (text states it too) -->
        <Style Selector="Border.linkChip">
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.linkChip.up">
            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RxGreenBrush}" />
        </Style>
        <Style Selector="Ellipse.chipDot">
            <Setter Property="Fill" Value="{DynamicResource AmberAccentBrush}" />
        </Style>
        <Style Selector="Ellipse.chipDot.up">
            <Setter Property="Fill" Value="{DynamicResource RxGreenBrush}" />
        </Style>
        <!-- A node you are hearing: clearly green (was a 10% tint, too faint on the dark card) -->
        <Style Selector="Border.linkRow.rx">
            <Setter Property="Background" Value="{DynamicResource RxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RxGreenBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.linkRow.tx">
            <Setter Property="BorderBrush" Value="{DynamicResource TxRedBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Background" Value="{DynamicResource TxBackgroundBrush}" />
        </Style>
        <!-- The transmit node that is also being heard: keep the red border (it is where you talk) but go green
             inside. Before, the tx rule came later and hid rx entirely, so the transmit node never showed audio. -->
        <Style Selector="Border.linkRow.tx.rx">
            <Setter Property="Background" Value="{DynamicResource RxBackgroundBrush}" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize11}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Phone / narrow mode (the 'narrow' class is toggled by MainView.axaml.cs): finger-sized targets -->
        <Style Selector="UserControl.narrow Button">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="UserControl.narrow TextBox">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="UserControl.narrow Button.key">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize18}" />
        </Style>
        <Style Selector="UserControl.narrow Button#PttButton">
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Phone bottom navigation: the selected tab is bold with a cyan bar on top, not colour alone -->
        <Style Selector="Button.navTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.navTab TextBlock.navLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSize11}" />
        </Style>
        <Style Selector="Button.navTab.selected">
            <Setter Property="Foreground" Value="{DynamicResource CyanAccentBrush}" />
        </Style>
        <Style Selector="Button.navTab.selected TextBlock.navLabel">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.navTab Border.navBar">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.navTab.selected Border.navBar">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- TOP APP / CONSOLE HEADER -->
        <Border x:Name="HeaderBorder" Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
          <StackPanel Spacing="8">
            <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto">

                <!-- Branding -->
                <StackPanel x:Name="BrandPanel" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="avares://NodeX.UI/Assets/nodex-mark.png" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NodeX" FontSize="{DynamicResource FontSize18}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="BrandTagline" Text="AllStarLink Radioless Node" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Station callout -->
                <Border x:Name="StationBadge" Grid.Column="1" HorizontalAlignment="Center"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="20" Padding="14,6">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                        <TextBlock Text="STATION:" FontWeight="SemiBold" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocalNodeNumber, StringFormat='Node {0}'}" FontWeight="Bold" FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource CyanAccentBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Border>

                <!-- Registration + Bluetooth badges (wrap onto a second line when space is tight) -->
                <WrapPanel x:Name="BadgesPanel" Grid.Column="2" Orientation="Horizontal"
                           ItemSpacing="10" LineSpacing="6" VerticalAlignment="Center">
                    <!-- Always visible on the Radio screen while transmitting is off (microphone denied) -->
                    <Border x:Name="ListenOnlyChip" IsVisible="{Binding IsTransmitBlocked}" CornerRadius="12" Padding="10,5"
                            Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource AmberAccentBrush}" BorderThickness="1"
                            ToolTip.Tip="{Binding TransmitBlockedText}" AutomationProperties.Name="Listen only: transmitting is off">
                        <TextBlock Text="LISTEN ONLY" FontSize="{DynamicResource FontSize11}" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" />
                    </Border>

                    <Border Classes="card" CornerRadius="12" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="AslDot" Width="8" Height="8" Classes.registered="{Binding IsAslRegistered}" />
                            <TextBlock Text="{Binding AslStatusText}" FontSize="{DynamicResource FontSize11}" MaxWidth="240"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" CornerRadius="12" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="BleDot" Width="8" Height="8" Classes.connected="{Binding IsBleConnected}" />
                            <TextBlock Text="{Binding BleStatusText}" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Navigation (including Settings) is the bottom bar, at every width. -->
                <StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal" Spacing="8"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="ExitButton" AutomationProperties.Name="Exit NodeX" Content="Exit"
                            Command="{Binding ExitCommand}" IsVisible="{Binding CanExit}"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            CornerRadius="12" Padding="12,5" FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Button Command="{Binding OpenSettingsCommand}"
                    IsVisible="{Binding Settings.Updates.HasUpdate}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="App update available. Open Settings.">
                <TextBlock Text="{Binding Settings.Updates.AvailableText}" TextWrapping="Wrap" />
            </Button>

            <!-- Links strip: always visible, so scrolling to the log never hides what you are connected to -->
            <WrapPanel x:Name="HeaderLinksStrip" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <TextBlock Text="{Binding LinkCountText, StringFormat='LINKED {0}'}" IsVisible="{Binding HasLinks}"
                           FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="Not linked to any node" IsVisible="{Binding !HasLinks}"
                           FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ItemsControl ItemsSource="{Binding LinkItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkItemViewModel">
                            <Border Classes="linkChip" Classes.up="{Binding IsConnected}"
                                    Margin="0,0,6,4" CornerRadius="12" Padding="9,3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Classes="chipDot" Classes.up="{Binding IsConnected}" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChipTitle}" FontSize="{DynamicResource FontSize12}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ChipStatus}" FontSize="{DynamicResource FontSize11}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- MAIN BODY CONTENT -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Padding="16" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="BodyGrid" ColumnDefinitions="*,360" HorizontalAlignment="Stretch">

                <!-- LEFT COLUMN (wide layout): transceiver hero, RX/TX, meters, PTT -->
                <StackPanel x:Name="LeftColumn" Grid.Column="0" Spacing="16" Margin="0,0,16,0">

                    <!-- HERO NODE DISPLAY CARD -->
                    <Border x:Name="HeroCard" Classes="card" Padding="20">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" CornerRadius="6" Padding="8,4" Background="{DynamicResource SelectedBackgroundBrush}">
                                    <TextBlock Text="{Binding ConnectionStateBadgeText}"
                                               FontWeight="Bold" FontSize="{DynamicResource FontSize11}"
                                               Foreground="{DynamicResource CyanAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="RTT:" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding LatencyText}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,16,0,8">
                                <TextBlock Text="{Binding ConnectedNodeDisplay}"
                                           FontSize="{DynamicResource FontSize32}" FontWeight="Black"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ConnectedNodeDetails}"
                                           FontSize="{DynamicResource FontSize13}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <!-- Optional station-ID reminder (text only; nothing is transmitted) -->
                                <Border IsVisible="{Binding IsIdReminderDue}" Margin="0,12,0,0" Padding="12,8"
                                        CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource AmberAccentBrush}" Background="{DynamicResource WarningBackgroundBrush}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Time to identify (say your callsign)." FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AmberAccentBrush}" />
                                        <Button Grid.Column="1" Content="I've identified" Command="{Binding AcknowledgeIdCommand}"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource AmberAccentBrush}" BorderThickness="1"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                CornerRadius="8" Padding="10,5" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- AUDIO VU METERS -->
                    <Border x:Name="MetersCard" Classes="card" CornerRadius="10">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="50,*,40">
                                <TextBlock Grid.Column="0" Text="MIC" FontWeight="Bold" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" AutomationProperties.Name="Microphone level" Minimum="0" Maximum="1" Value="{Binding MicAudioLevel}"
                                             Height="8" CornerRadius="4" Margin="8,0"
                                             Foreground="{DynamicResource TxRedBrush}" Background="{DynamicResource SelectedBackgroundBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding MicAudioLevel, StringFormat='{}{0:P0}'}" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="50,*,40">
                                <TextBlock Grid.Column="0" Text="SPK" FontWeight="Bold" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1" AutomationProperties.Name="Speaker level" Minimum="0" Maximum="1" Value="{Binding RxAudioLevel}"
                                             Height="8" CornerRadius="4" Margin="8,0"
                                             Foreground="{DynamicResource RxGreenBrush}" Background="{DynamicResource SelectedBackgroundBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding RxAudioLevel, StringFormat='{}{0:P0}'}" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PUSH-TO-TALK: sits in the left column on wide screens, docks to the bottom on phones -->
                    <Border x:Name="PttCard" Classes="card" CornerRadius="16" Padding="24">
                        <StackPanel x:Name="PttInner" Spacing="18" HorizontalAlignment="Center">

                            <!-- The key, with the Android phone/speaker chip beside it (thumb reach) -->
                            <Grid x:Name="PttRow" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Center">
                            <Button x:Name="PttButton" Grid.Column="0" AutomationProperties.Name="Push to talk"
                                    Width="260" Height="140" Padding="0"
                                    CornerRadius="20" BorderThickness="0" Background="Transparent"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    IsEnabled="{Binding CanKey}"
                                    Command="{Binding TogglePttClickCommand}">
                                <Button.Resources>
                                    <!-- Neutralise the theme's own hover/press fills; the visible face is PttFace -->
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                </Button.Resources>
                                <Border x:Name="PttFace" CornerRadius="20" BorderThickness="3"
                                        Classes.keyed="{Binding IsTransmitting}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="PttCaption" Text="{Binding PttCaption}" FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                                    HorizontalAlignment="Center" />
                                        <TextBlock Classes="pttText" Text="{Binding PttHeadline}" FontSize="{DynamicResource FontSize20}" FontWeight="Black"
                                                    HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding TxDurationDisplay}" FontSize="{DynamicResource FontSize16}" FontWeight="Bold"
                                                    HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>

                                <!-- Phone earpiece / loudspeaker (Android only) -->
                                <Button x:Name="SpeakerButton" Grid.Column="1" IsVisible="{Binding CanSwitchSpeaker}" Command="{Binding ToggleSpeakerCommand}"
                                        AutomationProperties.Name="Switch between phone and speaker audio"
                                        Content="{Binding SpeakerChipText}"
                                        Width="76" Padding="4" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Background="{DynamicResource SelectedBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="12" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" />
                            </Grid>

                            <!-- Shown when transmitting is off (microphone access denied). Listening still works. -->
                            <Border x:Name="TxBlockedBanner" IsVisible="{Binding IsTransmitBlocked}"
                                    Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource AmberAccentBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding TransmitBlockedText}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <Button Content="Allow microphone" Command="{Binding FixMicrophoneCommand}"
                                            IsVisible="{Binding CanFixMicrophone}" HorizontalAlignment="Left"
                                            Padding="12,6" CornerRadius="6" FontSize="{DynamicResource FontSize12}" />
                                </StackPanel>
                            </Border>

                            <!-- Nodes are linked but none is chosen for transmit: say so (the key stays inert) -->
                            <Border x:Name="ChooseTxBanner" IsVisible="{Binding NeedsTransmitNode}"
                                    Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource AmberAccentBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <TextBlock Text="Pick which linked node to transmit to." TextWrapping="Wrap" FontSize="{DynamicResource FontSize12}"
                                           Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.LiveSetting="Polite" />
                            </Border>

                            <StackPanel x:Name="PttInfo" Spacing="8" Width="300">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Time-Out Timer (TOT)" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotCounterText}" FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                                <ProgressBar AutomationProperties.Name="Transmit time-out used" Minimum="0" Maximum="1" Value="{Binding TotProgressPercent}"
                                             Height="6" CornerRadius="3"
                                             Foreground="{DynamicResource AmberAccentBrush}" Background="{DynamicResource SelectedBackgroundBrush}" />

                                <Button Command="{Binding TogglePttModeCommand}"
                                        AutomationProperties.Name="Switch push-to-talk mode"
                                        HorizontalAlignment="Center" Margin="0,4,0,0"
                                        Background="{DynamicResource SelectedBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="14" Padding="12,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Mode:" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PttModeLabel}" FontSize="{DynamicResource FontSize12}" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PttModeHint" Text="⇄ tap to switch" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN (wide layout): connect, DTMF, log -->
                <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="16">

                    <!-- PHONE, Radio tab: station-ID reminder (the big hero card is not shown on phones) -->
                    <Border x:Name="IdReminderCard" IsVisible="{Binding IsIdReminderDue}" Padding="12,8"
                            CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource AmberAccentBrush}" Background="{DynamicResource WarningBackgroundBrush}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="Time to identify (say your callsign)." FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AmberAccentBrush}" />
                            <Button Grid.Column="1" Content="I've identified" Command="{Binding AcknowledgeIdCommand}"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource AmberAccentBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    CornerRadius="8" Padding="10,5" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- PHONE, Radio tab: slim link rows. "Transmit here" picks the transmit node; mute from here.
                         Connect / disconnect / favourites live on the Nodes tab. -->
                    <Border x:Name="CompactLinksCard" Classes="card" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="LINKS" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                           Foreground="{DynamicResource CyanAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LinkCountText}" IsVisible="{Binding HasLinks}" FontSize="{DynamicResource FontSize11}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Spacing="8" IsVisible="{Binding !HasLinks}">
                                <TextBlock Text="Not linked to any node." FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="Connect to a node…" Click="OnGoToNodesClick" HorizontalAlignment="Left"
                                        Padding="14,8" CornerRadius="6" FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding LinkItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LinkItemViewModel">
                                        <Border Classes="linkRow" Classes.tx="{Binding IsTransmitTarget}" Classes.rx="{Binding IsReceiving}" Padding="10,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{DynamicResource FontSize14}" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Grid.Column="1" IsVisible="{Binding IsTransmitTarget}" VerticalAlignment="Center"
                                                            CornerRadius="6" Padding="8,3" Background="{DynamicResource TransmitFillBrush}">
                                                        <TextBlock Text="TRANSMIT" FontSize="{DynamicResource FontSize11}" FontWeight="Black" Foreground="{DynamicResource OnRedBrush}" />
                                                    </Border>
                                                    <Border Grid.Column="1" IsVisible="{Binding CanSelectTransmit}" VerticalAlignment="Center"
                                                            CornerRadius="6" Padding="8,3" Background="{DynamicResource SelectedBackgroundBrush}">
                                                        <TextBlock Text="LISTEN ONLY" FontSize="{DynamicResource FontSize11}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontSize11}" FontWeight="Bold"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding RttText}" FontSize="{DynamicResource FontSize11}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <Border IsVisible="{Binding IsReceiving}" CornerRadius="8" Padding="7,1"
                                                            Background="{DynamicResource RxGreenBrush}">
                                                        <TextBlock Text="● RX" FontSize="{DynamicResource FontSize11}" FontWeight="Black" Foreground="{DynamicResource OnGreenBrush}"
                                                                   AutomationProperties.LiveSetting="Polite" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastHeardText}" FontSize="{DynamicResource FontSize11}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding RemoteLinksText}" IsVisible="{Binding HasRemoteLinks}"
                                                           FontSize="{DynamicResource FontSize11}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource CyanAccentBrush}" />
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <Button Grid.Column="0" IsVisible="{Binding CanSelectTransmit}" Content="Transmit here"
                                                            Command="{Binding SelectTransmitCommand}"
                                                            AutomationProperties.Name="{Binding SelectAutomationName}"
                                                            Background="{DynamicResource SelectedBackgroundBrush}" CornerRadius="6" Padding="8,6" FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                                                    <Button Grid.Column="2" Command="{Binding ToggleMuteCommand}"
                                                            AutomationProperties.Name="{Binding MuteAutomationName}"
                                                            Background="{DynamicResource SelectedBackgroundBrush}" CornerRadius="6" Padding="8,4" MinWidth="52"
                                                            HorizontalContentAlignment="Center">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding MuteGlyph}" FontSize="{DynamicResource FontSize14}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding MuteShortText}" FontSize="{DynamicResource FontSize10}" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="3" Command="{Binding DisconnectCommand}"
                                                            AutomationProperties.Name="{Binding DisconnectAutomationName}"
                                                            Background="{DynamicResource DangerButtonBrush}" Foreground="#FFFFFF"
                                                            CornerRadius="6" Padding="8,4" MinWidth="52"
                                                            HorizontalContentAlignment="Center">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="✕" FontSize="{DynamicResource FontSize14}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Disconnect" FontSize="{DynamicResource FontSize10}" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- LINKED NODES: up to 4 at once; only one is the transmit node, the rest are listen-only -->
                    <Border x:Name="LinksCard" Classes="card" IsVisible="{Binding HasLinks}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Linked nodes" FontWeight="Bold" FontSize="{DynamicResource FontSize14}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,3" Background="{DynamicResource SelectedBackgroundBrush}">
                                    <TextBlock Text="{Binding LinkCountText}" FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource CyanAccentBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="Choose one node to transmit to. All other links are listen-only."
                                       FontSize="{DynamicResource FontSize12}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <ItemsControl ItemsSource="{Binding LinkItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LinkItemViewModel">
                                        <Border Classes="linkRow" Classes.tx="{Binding IsTransmitTarget}" Classes.rx="{Binding IsReceiving}">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize15}" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Details}" FontSize="{DynamicResource FontSize11}" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding HasDetails}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontSize11}" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding RttText}" FontSize="{DynamicResource FontSize11}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <Border IsVisible="{Binding IsReceiving}" CornerRadius="8" Padding="7,1"
                                                                    Background="{DynamicResource RxGreenBrush}">
                                                                <TextBlock Text="● RX" FontSize="{DynamicResource FontSize11}" FontWeight="Black" Foreground="{DynamicResource OnGreenBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding LastHeardText}" FontSize="{DynamicResource FontSize11}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding RemoteLinksText}" IsVisible="{Binding HasRemoteLinks}"
                                                                   FontSize="{DynamicResource FontSize11}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource CyanAccentBrush}" />
                                                    </StackPanel>
                                                    <!-- Text pill, so "audio is arriving from this node" is not colour-only -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                                        <Border IsVisible="{Binding IsReceiving}" VerticalAlignment="Center"
                                                                CornerRadius="12" Padding="8,4" Background="{DynamicResource SuccessBackgroundBrush}"
                                                                BorderBrush="{DynamicResource RxGreenBrush}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource RxGreenBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="Receiving" FontSize="{DynamicResource FontSize11}" FontWeight="Bold"
                                                                           AutomationProperties.LiveSetting="Polite"
                                                                           Foreground="{DynamicResource RxGreenBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Favourite this node: star toggles, pencil (favourites only) renames -->
                                                        <Button Content="✎" FontSize="{DynamicResource FontSize14}" IsVisible="{Binding IsFavorite}"
                                                                Command="{Binding ToggleEditLabelCommand}"
                                                                AutomationProperties.Name="{Binding RenameAutomationName}"
                                                                MinWidth="36" MinHeight="36" Padding="0" CornerRadius="6"
                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                        </Button>
                                                        <Button Content="{Binding FavoriteGlyph}" FontSize="{DynamicResource FontSize20}"
                                                                Command="{Binding ToggleFavoriteCommand}"
                                                                AutomationProperties.Name="{Binding FavoriteAutomationName}"
                                                                MinWidth="40" MinHeight="36" Padding="0" CornerRadius="6"
                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                Foreground="{DynamicResource AmberAccentBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Inline rename (not a popup, which the Android keyboard would cover) -->
                                                <StackPanel Spacing="6" IsVisible="{Binding IsEditingLabel}">
                                                    <TextBlock Text="Favorite name" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBox AutomationProperties.Name="Favorite name"
                                                             Text="{Binding LabelInput}" MaxLength="40"
                                                             PlaceholderText="e.g. East Coast Reflector">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter" Command="{Binding SaveLabelCommand}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                        <Button Content="Cancel" Command="{Binding ToggleEditLabelCommand}"
                                                                Padding="14,6" CornerRadius="6" />
                                                        <Button Content="Save" Command="{Binding SaveLabelCommand}"
                                                                Padding="14,6" CornerRadius="6" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Border Grid.Column="0" IsVisible="{Binding IsTransmitTarget}" VerticalAlignment="Center"
                                                            CornerRadius="6" Padding="10,6" Background="{DynamicResource TransmitFillBrush}">
                                                        <TextBlock Text="TRANSMIT HERE" FontSize="{DynamicResource FontSize11}" FontWeight="Black" Foreground="{DynamicResource OnRedBrush}" />
                                                    </Border>
                                                    <Border Grid.Column="0" IsVisible="{Binding CanSelectTransmit}" VerticalAlignment="Center"
                                                            CornerRadius="6" Padding="10,6" Background="{DynamicResource SelectedBackgroundBrush}">
                                                        <TextBlock Text="Listen only" FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Transmit here" Command="{Binding SelectTransmitCommand}"
                                                            IsVisible="{Binding CanSelectTransmit}"
                                                            AutomationProperties.Name="{Binding SelectAutomationName}"
                                                            Background="{DynamicResource SelectedBackgroundBrush}" CornerRadius="6" Padding="12,6" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" />
                                                </Grid>

                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Button Grid.Column="0" Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}"
                                                            AutomationProperties.Name="{Binding MuteAutomationName}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Background="{DynamicResource SelectedBackgroundBrush}" CornerRadius="6" Padding="10,6" FontSize="{DynamicResource FontSize12}" />
                                                    <Button Grid.Column="1" Content="Disconnect" Command="{Binding DisconnectCommand}"
                                                            AutomationProperties.Name="{Binding DisconnectAutomationName}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Background="{DynamicResource DangerButtonBrush}" Foreground="#FFFFFF"
                                                            CornerRadius="6" Padding="10,6" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding LinkHintText}"
                                       FontSize="{DynamicResource FontSize11}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- CONNECT / DIAL CONTROL -->
                    <Border x:Name="ConnectCard" Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Connect to Node" FontWeight="Bold" FontSize="{DynamicResource FontSize14}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Connect adds another link; the nodes you are already linked to stay up."
                                       IsVisible="{Binding HasLinks}" FontSize="{DynamicResource FontSize11}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <Grid x:Name="ConnectGrid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                                <!-- Star saves the number typed in the box; the pencil (favourites only) renames it -->
                                <StackPanel x:Name="TargetFavButtons" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                                    <Button Content="{Binding TargetFavoriteGlyph}" FontSize="{DynamicResource FontSize20}"
                                            AutomationProperties.Name="{Binding TargetFavoriteName}"
                                            Command="{Binding ToggleTargetFavoriteCommand}"
                                            MinWidth="44" MinHeight="40" Padding="0" CornerRadius="6"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Foreground="{DynamicResource AmberAccentBrush}" />
                                    <Button Content="✎" FontSize="{DynamicResource FontSize16}" IsVisible="{Binding TargetIsFavorite}"
                                            Command="{Binding ToggleEditFavoriteLabelCommand}"
                                            AutomationProperties.Name="Rename this favorite"
                                            MinWidth="36" MinHeight="40" Padding="0" CornerRadius="6"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    </Button>
                                </StackPanel>
                                <TextBox x:Name="TargetBox" AutomationProperties.Name="Node number to connect to" Grid.Column="1" Text="{Binding TargetNodeInput}"
                                         PlaceholderText="e.g. 27339" Margin="0,0,8,0"
                                         FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"
                                         CornerRadius="6" VerticalContentAlignment="Center" />
                                <Grid x:Name="ConnectButtons" Grid.Column="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="0" Command="{Binding ConnectNodeCommand}"
                                            IsEnabled="{Binding CanConnect}"
                                            Background="{DynamicResource RxGreenBrush}"
                                            Foreground="{DynamicResource OnGreenBrush}" FontWeight="Bold"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            CornerRadius="6" Padding="14,8">
                                        Connect
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding RequestDisconnectNodeCommand}"
                                            IsEnabled="{Binding CanDisconnect}"
                                            Background="{DynamicResource DangerButtonBrush}"
                                            Foreground="#FFFFFF" FontWeight="Bold"
                                            Content="{Binding DisconnectAllText}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            CornerRadius="6" Padding="14,8" />
                                </Grid>
                            </Grid>

                            <!-- Confirmation when multiple links are up so a stray tap does not drop every link -->
                            <Border IsVisible="{Binding IsConfirmingDisconnectAll}"
                                    Background="{DynamicResource ErrorBackgroundBrush}" BorderBrush="{DynamicResource TxRedBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Disconnect all linked nodes?" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TxRedBrush}" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelDisconnectAllCommand}"
                                            Padding="10,4" CornerRadius="6" FontSize="{DynamicResource FontSize12}" />
                                    <Button Grid.Column="2" Content="Disconnect all" Command="{Binding DisconnectNodeCommand}"
                                            Background="{DynamicResource DangerButtonBrush}" Foreground="#FFFFFF"
                                            Padding="10,4" CornerRadius="6" FontSize="{DynamicResource FontSize12}" FontWeight="Bold" />
                                </Grid>
                            </Border>

                            <!-- Inline rename (not a popup, which the Android keyboard would cover) -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsEditingFavoriteLabel}">
                                <TextBlock Text="Favorite name" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox AutomationProperties.Name="Favorite name"
                                         Text="{Binding FavoriteLabelInput}" MaxLength="40"
                                         PlaceholderText="e.g. East Coast Reflector">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SaveFavoriteLabelCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Command="{Binding ToggleEditFavoriteLabelCommand}"
                                            Padding="14,6" CornerRadius="6" />
                                    <Button Content="Save" Command="{Binding SaveFavoriteLabelCommand}"
                                            Padding="14,6" CornerRadius="6" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <Button Command="{Binding OpenSearchCommand}" AutomationProperties.Name="Find a node"
                                    HorizontalAlignment="Left" Padding="12,8" CornerRadius="6" FontSize="{DynamicResource FontSize13}">
                                🔍 Find a node…
                            </Button>

                            <StackPanel Spacing="6" IsVisible="{Binding HasFavorites}">
                                <TextBlock Text="Favorites (tap to connect, drag to reorder)" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ItemsControl x:Name="FavoritesList" ItemsSource="{Binding FavoriteNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FavoriteItem">
                                            <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectFavoriteNodeCommand}"
                                                    CommandParameter="{Binding Node}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    Margin="0,0,6,6" Padding="10,6"
                                                    Background="{DynamicResource SelectedBackgroundBrush}" CornerRadius="6" BorderThickness="0">
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="Remove from favorites"
                                                                  Click="OnRemoveFavoriteClick" />
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource CyanAccentBrush}" />
                                                    <TextBlock Text="{Binding Node}" FontSize="{DynamicResource FontSize11}" IsVisible="{Binding HasLabel}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DTMF KEYPAD -->
                    <Border x:Name="DtmfCard" Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="DTMF Radio Commands" FontWeight="Bold" FontSize="{DynamicResource FontSize14}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding DtmfTargetText}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <ItemsControl ItemsSource="{Binding DtmfKeys}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="key" Content="{Binding}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SendDtmfDigitCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="AllStarLink function shortcuts. Link and Unlink use the node number typed in the Connect box; they ask the node above to link to or drop that node (the connection itself isn't changed)." TextWrapping="Wrap" FontSize="{DynamicResource FontSize11}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
                                    <Button Grid.Column="0" Classes="chip" Content="*3 Link" Command="{Binding SendDtmfMacroCommand}" CommandParameter="link" />
                                    <Button Grid.Column="1" Classes="chip" Content="*1 Unlink" Command="{Binding SendDtmfMacroCommand}" CommandParameter="unlink" />
                                    <Button Grid.Column="2" Classes="chip" Content="*70 Status" Command="{Binding SendDtmfMacroCommand}" CommandParameter="status" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- LIVE ACTIVITY LOG -->
                    <Border x:Name="LogCard" Classes="card" Height="220">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0" Text="Event Log" FontWeight="Bold" FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="CopyLogButton" Content="Copy" Click="OnCopyLogClick"
                                            AutomationProperties.Name="Copy event log to clipboard"
                                            Background="Transparent" BorderThickness="0" FontSize="{DynamicResource FontSize11}"
                                            Foreground="{DynamicResource CyanAccentBrush}" Padding="8,0" />
                                    <Button Content="Clear" Command="{Binding ClearLogCommand}"
                                            Background="Transparent" BorderThickness="0" FontSize="{DynamicResource FontSize11}"
                                            Foreground="{DynamicResource CyanAccentBrush}" Padding="8,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Read-only TextBox: unlike SelectableTextBlock it gives touch selection handles on Android, and
                                 still selects with the mouse on desktop. Copy copies everything. -->
                            <TextBox x:Name="LogTextBox" Grid.Row="1" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="{DynamicResource FontSize11}"
                                     AutomationProperties.Name="Event log text"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- PTT DOCK: on phones the PTT card lives here, pinned to the bottom within thumb reach -->
        <Border x:Name="PttDock" Grid.Row="2" IsVisible="False"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,10" />

        <!-- PHONE BOTTOM NAVIGATION (narrow layout only; shown/hidden by MainView.axaml.cs) -->
        <Border x:Name="NavBar" Grid.Row="3" IsVisible="False"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <Button x:Name="NavRadio" Grid.Column="0" Classes="navTab" Click="OnNavClick" Tag="0"
                        AutomationProperties.Name="Radio tab">
                    <StackPanel>
                        <Border Classes="navBar" Height="3" Background="{DynamicResource CyanAccentBrush}" Margin="12,0,12,4" />
                        <!-- Handheld ham transceiver: antenna, knob, display, speaker grille. Follows the tab's colour. -->
                        <Path Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M16 1.5 V6 M10 3.5 V6 M9 6 H15 A2 2 0 0 1 17 8 V20 A2 2 0 0 1 15 22 H9 A2 2 0 0 1 7 20 V8 A2 2 0 0 1 9 6 Z M9.5 8.5 H14.5 V11.5 H9.5 Z M9.5 14.5 H14.5 M9.5 16.5 H14.5 M9.5 18.5 H14.5" />
                        <TextBlock Classes="navLabel" Text="Radio" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavNodes" Grid.Column="1" Classes="navTab" Click="OnNavClick" Tag="1"
                        AutomationProperties.Name="Nodes tab">
                    <StackPanel>
                        <Border Classes="navBar" Height="3" Background="{DynamicResource CyanAccentBrush}" Margin="12,0,12,4" />
                        <TextBlock Text="🔗" FontSize="{DynamicResource FontSize18}" HorizontalAlignment="Center" />
                        <TextBlock Classes="navLabel" Text="Nodes" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavKeypad" Grid.Column="2" Classes="navTab" Click="OnNavClick" Tag="2"
                        AutomationProperties.Name="Keypad tab">
                    <StackPanel>
                        <Border Classes="navBar" Height="3" Background="{DynamicResource CyanAccentBrush}" Margin="12,0,12,4" />
                        <TextBlock Text="🔢" FontSize="{DynamicResource FontSize18}" HorizontalAlignment="Center" />
                        <TextBlock Classes="navLabel" Text="Keypad" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavLog" Grid.Column="3" Classes="navTab" Click="OnNavClick" Tag="3"
                        AutomationProperties.Name="Log tab">
                    <StackPanel>
                        <Border Classes="navBar" Height="3" Background="{DynamicResource CyanAccentBrush}" Margin="12,0,12,4" />
                        <TextBlock Text="📜" FontSize="{DynamicResource FontSize18}" HorizontalAlignment="Center" />
                        <TextBlock Classes="navLabel" Text="Log" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Not a tab: opens the Settings screen -->
                <Button x:Name="NavSettings" Grid.Column="4" Classes="navTab" Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="Settings">
                    <StackPanel>
                        <Border Classes="navBar" Height="3" Background="{DynamicResource CyanAccentBrush}" Margin="12,0,12,4" />
                        <TextBlock Text="⚙" FontSize="{DynamicResource FontSize18}" HorizontalAlignment="Center" />
                        <TextBlock Classes="navLabel" Text="Settings" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- FIND A NODE OVERLAY -->
        <Border Grid.RowSpan="4" IsVisible="{Binding IsSearchOpen}"
                Background="{DynamicResource ConsoleBackgroundBrush}">
            <views:NodeSearchView DataContext="{Binding Search}" />
        </Border>

        <!-- SETTINGS OVERLAY (full screen so it works on phones as well as desktop) -->
        <Border Grid.RowSpan="4" IsVisible="{Binding IsSettingsOpen}"
                Background="{DynamicResource ConsoleBackgroundBrush}">
            <views:SettingsView DataContext="{Binding Settings}" />
        </Border>
    </Grid>
</UserControl>
