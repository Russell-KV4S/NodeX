<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NodeX.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:NodeX.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="720"
        Width="1050" Height="720"
        MinWidth="340" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        x:Class="NodeX.UI.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="NodeX — AllStarLink Console (Asterisk-Free)"
        Background="{StaticResource ConsoleBackgroundBrush}">
        <views:MainView />
</Window>
