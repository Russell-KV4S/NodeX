<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NodeX.UI"
             x:Class="NodeX.UI.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- Color Palette for Professional Radio Console -->
        <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161B22" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1F242C" />

        <SolidColorBrush x:Key="TxRedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TxRedGlowBrush" Color="#4DE53E3E" />
        <SolidColorBrush x:Key="RxGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="RxGreenGlowBrush" Color="#4D10B981" />
        <SolidColorBrush x:Key="AmberAccentBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#06B6D4" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F6FC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
        <!-- Muted text was #484F58 (2.1:1 on cards). #848D97 is 5.1:1 on cards and 4.6:1 on the header, so hints stay readable (WCAG AA). -->
        <SolidColorBrush x:Key="TextMutedBrush" Color="#848D97" />

        <!-- Fill for buttons that carry white text: #EF4444 gives only 3.8:1 with white, #DC2626 gives 4.8:1. -->
        <SolidColorBrush x:Key="DangerButtonBrush" Color="#DC2626" />
    </Application.Resources>
</Application>
